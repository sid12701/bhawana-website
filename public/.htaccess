# Bhawana Capital — Apache/cPanel rules (copied to site root on deploy)

DirectoryIndex index.html index.htm
# The static export ships a branded 404 page; without this Apache shows its bare default
ErrorDocument 404 /404.html
Options -MultiViews

RewriteEngine On

# cPanel "Account Suspended" CGI is served by a server-level ScriptAlias, so
# .htaccess often cannot intercept it. robots.txt disallows /cgi-sys/.
RewriteRule ^cgi-sys/suspendedpage\.cgi$ / [R=301,L]

# Legacy PHP URL from the previous site
RewriteRule ^personal-loan\.php$ /personal-loan/ [R=301,L]

# Retired LoanFront DSA/LSP page → public terminated-vendors disclosure
RewriteRule ^loanfront/?$ /terminated-vendors/ [R=301,L]

# Canonical URL is https://www.bhawanafinance.com/<path>/
# Extensionless pages without a trailing slash are a separate cache key. On 7 Oct 2026
# those URLs were still serving the pre-5-Oct HTML (old grievance number in the body,
# tel: links, and footer) while the trailing-slash URL was already updated.
# Match the path only — a query string is not part of the RewriteRule subject, so it is
# appended to the Location and must not be dropped. Do not match a trailing slash or a
# dotted filename, or the internal Hindi .html rewrite below will loop.
# Non-www or http, extensionless, no trailing slash: one hop to https www with the slash.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.bhawanafinance\.com$ [NC]
RewriteRule ^([^.]*[^./])$ https://www.bhawanafinance.com/$1/ [R=301,L,E=CANONICAL_REDIRECT:1]

# Non-www or http for everything else (files, and paths that already end in a slash).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.bhawanafinance\.com$ [NC]
RewriteRule ^(.*)$ https://www.bhawanafinance.com/$1 [R=301,L,E=CANONICAL_REDIRECT:1]

# www + https, extensionless, no trailing slash → the same path with a slash.
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteRule ^([^.]*[^./])$ /$1/ [R=301,L,E=CANONICAL_REDIRECT:1]

# Legacy KYC URL → current policy (HTTP 301, not client-side)
RewriteRule ^kyc-aml-policy/?$ /kyc-aml-cft-policy/ [R=301,L]

# Broken/legacy refund URL → real policy page
RewriteRule ^refund-policy/?$ /refund-cancellation-policy/ [R=301,L]

# Mistyped internal paths that previously 404'd
RewriteRule ^grievance-redressal/?$ /grievance-redressal-policy/ [R=301,L]
RewriteRule ^terms-and-conditions/?$ /terms-conditions/ [R=301,L]

# Old homepage blog card URLs (missing /blog/ and wrong slugs) → live posts
RewriteRule ^why-taking-a-personal-loan-is-beneficial/?$ /blog/why-taking-a-personal-loan-is-beneficial/ [R=301,L]
RewriteRule ^how-to-unite-daily-work-and-side-business/?$ /blog/how-do-i-unite-my-daily-work-and-small-side-business/ [R=301,L]
RewriteRule ^early-indicators-that-my-financial-situation-is-worsening/?$ /blog/what-are-the-early-indicators-that-my-financial-situation-is-worsening/ [R=301,L]
RewriteRule ^blog/how-to-unite-daily-work-and-side-business/?$ /blog/how-do-i-unite-my-daily-work-and-small-side-business/ [R=301,L]

# Gmail and other trackers sometimes append &query= to the path (e.g. /page/&source=gmail).
# Send those requests to the real policy page so borrowers do not see a 404.
RewriteRule ^(.+)/&.+$ /$1/ [R=301,L]

# Never index /index.html variants — always use clean trailing-slash URLs
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+(.+)/index\.html[\s?] [NC]
RewriteRule ^(.+)/index\.html$ /$1/ [R=301,L]

# Hindi RBI Ombudsman — flat .html is a host fallback only; never index it as a second URL.
# Match THE_REQUEST so the internal rewrite below does not create a redirect loop.
RewriteCond %{THE_REQUEST} \s/+rbi-ombudsman-salient-features-hindi\.html[\s?] [NC]
RewriteRule ^rbi-ombudsman-salient-features-hindi\.html$ /rbi-ombudsman-salient-features-hindi/ [R=301,L]
# Serve the published flat HTML internally when the clean trailing-slash URL is requested
RewriteRule ^rbi-ombudsman-salient-features-hindi/?$ /rbi-ombudsman-salient-features-hindi.html [L]

# Next.js static export: map clean URLs to folder index.html when present
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

<IfModule mod_headers.c>
  # The canonical-redirect rules set this env. "always" is required because a 301 is not a 2xx,
  # and without it a shared cache can keep an old 200 for the slashless URL.
  Header always set Cache-Control "no-cache, must-revalidate" env=CANONICAL_REDIRECT
  Header always set Pragma "no-cache" env=CANONICAL_REDIRECT
  Header always set Expires "0" env=CANONICAL_REDIRECT

  # Avoid stale HTML after compliance updates: no-cache makes browsers re-check with the server on every
  # visit (so updates show immediately) while still allowing a 304 and the back/forward cache, which no-store blocked.
  # Hashed /_next/static/ assets get a long cache from _next/static/.htaccess, written by scripts/postbuild-static-fallbacks.mjs.
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  # Keep HTML policy pages as the indexable canonical; PDFs are downloads only
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
</IfModule>

# Compress text responses. Both modules are guarded: AddOutputFilterByType needs mod_filter on Apache 2.4,
# and an unknown directive in .htaccess would 500 the whole site.
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript text/javascript application/json application/xml image/svg+xml
  </IfModule>
</IfModule>
