# Bhawana Capital — Apache/cPanel rules (copied to site root on deploy)

DirectoryIndex index.html index.htm
Options -MultiViews

RewriteEngine On

# Canonical host: apex → www (preserve path + query)
RewriteCond %{HTTP_HOST} ^bhawanafinance\.com$ [NC]
RewriteRule ^(.*)$ https://www.bhawanafinance.com/$1 [R=301,L]

# Legacy KYC URL → current policy (HTTP 301, not client-side)
RewriteRule ^kyc-aml-policy/?$ /kyc-aml-cft-policy/ [R=301,L]

# Broken/legacy refund URL → real policy page
RewriteRule ^refund-policy/?$ /refund-cancellation-policy/ [R=301,L]

# Gmail and other trackers sometimes append &query= to the path (e.g. /page/&source=gmail).
# Send those requests to the real policy page so borrowers do not see a 404.
RewriteRule ^(.+)/&.+$ /$1/ [R=301,L]

# Hindi RBI Ombudsman — serve published flat HTML (postbuild copy) at the canonical URL
RewriteRule ^rbi-ombudsman-salient-features-hindi/?$ /rbi-ombudsman-salient-features-hindi.html [L]

# Next.js static export: map clean URLs to folder index.html when present
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+?)/?$ $1/index.html [L]

# Retired LoanFront DSA/LSP page — return 410 Gone so search engines de-index faster
Redirect gone /loanfront
Redirect gone /loanfront/

<IfModule mod_headers.c>
  # Avoid stale HTML after compliance updates (PDFs and assets may still be cached by CDN)
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>
