# cPanel ScriptAlias still serves *.cgi from /usr/local/cpanel/cgi-sys/.
# This directory exists so non-CGI /cgi-sys/ requests are not a 200 "Account Suspended" page.
RewriteEngine On
RewriteRule ^$ / [R=301,L]
RewriteRule ^suspendedpage\.cgi$ / [R=301,L]

<IfModule mod_mime.c>
  RemoveHandler cgi-script .cgi
  ForceType text/html
</IfModule>
